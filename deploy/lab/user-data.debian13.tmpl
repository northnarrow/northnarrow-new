#cloud-config
# NorthNarrow local lab guest — Debian 13 "trixie" (kernel 6.12) variant
# of user-data.debian12.tmpl. Rendered once per `NN_LAB_DISTRO=debian13
# nn-lab.sh up`; __SSH_PUBKEY__ is substituted by the script.
#
# The lab's first guest on a kernel from 6.9, where the inode_setattr LSM
# hook takes `struct mnt_idmap *` before the dentry (lab PR 164).
#
# Differences from the Debian 12 template:
#   - nftables is installed: the lab's Debian 12 cloud image ships without
#     `nft`, so the per-process egress block and the COMBAT soft egress
#     block could not be exercised there (lab PR 119). This guest matches
#     the documented production prerequisite instead
#     (docs/operator/KERNEL_COMPATIBILITY.md);
#   - python3 is listed explicitly (the lab probes use it; the cloud image
#     ships it for cloud-init).
# Kept from Debian 12: bpftool is its own package, the explicit lsm= line
# (Debian's default list already ends in `bpf` on most kernels, but the
# guest matches docs/TAPPA7_PREREQ.md exactly), the Debian-family
# `perf_event_paranoid=3` drop-in that install.sh adds.
hostname: nn-lab-debian13
manage_etc_hosts: true
users:
  - name: nn
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
package_update: true
package_upgrade: false
packages:
  - iptables
  - nftables
  - bpftool
  - build-essential
  - pkg-config
  - git
  - rsync
  - jq
  - strace
  - curl
  - ca-certificates
  - python3
write_files:
  - path: /etc/default/grub.d/99-nn-bpf-lsm.cfg
    permissions: "0644"
    content: |
      GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT lsm=lockdown,capability,landlock,yama,apparmor,bpf"
runcmd:
  - update-grub
  # rustup (stable, minimal) for the guest-side userland build. External
  # audit LAB-009: no `curl | sh`; a pinned rustup-init is checked against
  # its pinned SHA-256 before it runs (rustup then checks each toolchain
  # component against the channel manifest). The repository's
  # rust-toolchain.toml (channel stable) applies once the tree is synced.
  - >-
    su - nn -c 'set -e; d=$(mktemp -d);
    curl -fsSL --proto =https --tlsv1.2 -o "$d/rustup-init"
    https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init;
    echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  $d/rustup-init"
    | sha256sum -c --strict --quiet -;
    chmod 0755 "$d/rustup-init";
    "$d/rustup-init" -y --profile minimal --default-toolchain stable;
    rm -rf "$d"'
  - su - nn -c 'echo "source \$HOME/.cargo/env" >> ~/.bashrc'
  - touch /var/lib/nn-lab-provisioned
power_state:
  mode: reboot
  message: "nn-lab: rebooting with lsm=...,bpf"
  condition: true
