#cloud-config
# NorthNarrow local lab guest — Debian 12 "bookworm" (kernel 6.1) variant
# of user-data.tmpl. Rendered once per `NN_LAB_DISTRO=debian12 nn-lab.sh
# up`; __SSH_PUBKEY__ is substituted by the script.
# The lsm= line ends in the placeholder for extra kernel arguments:
# " lockdown=integrity" on an NN_LAB_LOCKDOWN=integrity guest (lab PR 206),
# nothing otherwise.
#
# Differences from the Ubuntu 24.04 template:
#   - bpftool is its own package (no linux-tools-common on Debian);
#   - Debian's default LSM list is lockdown,capability,landlock,yama,
#     apparmor,tomoyo,bpf — `bpf` is already there on most kernels, but
#     the explicit lsm= line is kept so the lab guest matches the
#     documented production prerequisite exactly (docs/TAPPA7_PREREQ.md).
hostname: nn-lab-debian12
manage_etc_hosts: true
users:
  - name: nn
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
# The guest's ssh host key (external audit LAB-025, lab PR 211): a new
# ed25519 key for each instance, generated on the host by nn-lab.sh, which
# records its public half in the guest's known_hosts before the first boot,
# so the lab's first connection is already checked. cloud-init deletes the
# image's host keys and writes this one.
ssh_deletekeys: true
ssh_keys:
  ed25519_private: |
    __NN_LAB_HOST_KEY__
  ed25519_public: __NN_LAB_HOST_KEY_PUB__
package_update: true
package_upgrade: false
packages:
  - iptables
  # nft: the agent's per-process outbound block; install.sh refuses a host
  # without it (lab PR 165; Debian 12's cloud image has none)
  - nftables
  - bpftool
  - build-essential
  - pkg-config
  - git
  - rsync
  - jq
  - strace
  - curl
  - ca-certificates
write_files:
  - path: /etc/default/grub.d/99-nn-bpf-lsm.cfg
    permissions: "0644"
    content: |
      GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT lsm=lockdown,capability,landlock,yama,apparmor,bpf__NN_LAB_KARGS__"
runcmd:
  - update-grub
  # rustup (stable, minimal) for the guest-side userland build. External
  # audit LAB-009: no `curl | sh`; a pinned rustup-init is checked against
  # its pinned SHA-256 before it runs (rustup then checks each toolchain
  # component against the channel manifest). The repository's
  # rust-toolchain.toml (a pinned release since external audit SUP-015)
  # applies once the tree is synced: rustup installs it on the first build.
  - >-
    su - nn -c 'set -e; d=$(mktemp -d);
    curl -fsSL --proto =https --tlsv1.2 -o "$d/rustup-init"
    https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init;
    echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  $d/rustup-init"
    | sha256sum -c --strict --quiet -;
    chmod 0755 "$d/rustup-init";
    "$d/rustup-init" -y --profile minimal --default-toolchain stable;
    rm -rf "$d"'
  - su - nn -c 'echo "source \$HOME/.cargo/env" >> ~/.bashrc'
  - touch /var/lib/nn-lab-provisioned
power_state:
  mode: reboot
  message: "nn-lab: rebooting with lsm=...,bpf"
  condition: true
