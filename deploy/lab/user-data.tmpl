#cloud-config
# NorthNarrow local lab guest (deploy/lab/nn-lab.sh). Rendered once per
# `nn-lab.sh up`; __SSH_PUBKEY__ is substituted by the script.
hostname: nn-lab
manage_etc_hosts: true
users:
  - name: nn
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
package_update: true
package_upgrade: false
packages:
  - iptables
  # nft: the agent's per-process outbound block; install.sh refuses a host
  # without it (lab PR 165; Debian 12's cloud image has none)
  - nftables
  - bpftool
  - linux-tools-common
  - build-essential
  - pkg-config
  - git
  - rsync
  - jq
  - strace
  - curl
write_files:
  # BPF-LSM: Ubuntu 24.04 ships lockdown,capability,landlock,yama,apparmor;
  # the Tappa 7 anti-tamper hooks need `bpf` in the list.
  - path: /etc/default/grub.d/99-nn-bpf-lsm.cfg
    permissions: "0644"
    content: |
      GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT lsm=lockdown,capability,landlock,yama,apparmor,bpf"
runcmd:
  # Ubuntu's bpftool (linux-tools-common) is a wrapper; the tool itself is
  # in linux-tools-<running kernel>. The privileged fixtures need it to stop
  # their agents (lab PR 153). nn-lab.sh installs it again after a kernel
  # change.
  - 'DEBIAN_FRONTEND=noninteractive apt-get install -y "linux-tools-$(uname -r)"'
  - update-grub
  # rustup (stable, minimal) for the guest-side userland build. External
  # audit LAB-009: no `curl | sh`; a pinned rustup-init is checked against
  # its pinned SHA-256 before it runs (rustup then checks each toolchain
  # component against the channel manifest). The repository's
  # rust-toolchain.toml (channel stable) applies once the tree is synced.
  - >-
    su - nn -c 'set -e; d=$(mktemp -d);
    curl -fsSL --proto =https --tlsv1.2 -o "$d/rustup-init"
    https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init;
    echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  $d/rustup-init"
    | sha256sum -c --strict --quiet -;
    chmod 0755 "$d/rustup-init";
    "$d/rustup-init" -y --profile minimal --default-toolchain stable;
    rm -rf "$d"'
  - su - nn -c 'echo "source \$HOME/.cargo/env" >> ~/.bashrc'
  - touch /var/lib/nn-lab-provisioned
power_state:
  mode: reboot
  message: "nn-lab: rebooting with lsm=...,bpf"
  condition: true
