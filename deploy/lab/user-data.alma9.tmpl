#cloud-config
# NorthNarrow local lab guest — AlmaLinux 9 (kernel 5.14 + RHEL backports,
# native BTF) variant of user-data.tmpl. Rendered once per
# `NN_LAB_DISTRO=alma9 nn-lab.sh up`; __SSH_PUBKEY__ is substituted by
# the script.
# The lsm= line ends in the placeholder for extra kernel arguments:
# " lockdown=integrity" on an NN_LAB_LOCKDOWN=integrity guest (lab PR 206),
# nothing otherwise.
#
# Differences from the Ubuntu / Debian templates:
#   - dnf package names (`iptables-nft` provides iptables, `bpftool` is a
#     separate package, no build-essential meta-package);
#   - the kernel command line is edited with grubby, not grub.d;
#   - the el9 default LSM list is lockdown,yama,integrity,selinux,bpf —
#     `bpf` is already there, the explicit lsm= line keeps the guest equal
#     to the documented production prerequisite;
#   - SELinux stays ENFORCING on purpose: a RHEL-family host runs it, and
#     the lab must surface what it denies (bpffs, /etc/northnarrow,
#     the hardened units) instead of hiding it.
hostname: nn-lab-alma9
manage_etc_hosts: true
users:
  - name: nn
    groups: [wheel, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
package_update: true
package_upgrade: false
packages:
  - iptables-nft
  # nft: the agent's per-process outbound block; install.sh refuses a host
  # without it (lab PR 165; Debian 12's cloud image has none)
  - nftables
  - bpftool
  - gcc
  - make
  - pkgconf-pkg-config
  - git
  - rsync
  - jq
  - strace
  - curl
  - tar
  - xz
  - e2fsprogs
  - policycoreutils-python-utils
runcmd:
  - grubby --update-kernel=ALL --args="lsm=lockdown,capability,yama,integrity,selinux,bpf__NN_LAB_KARGS__"
  # rustup (stable, minimal) for the guest-side userland build. External
  # audit LAB-009: no `curl | sh`; a pinned rustup-init is checked against
  # its pinned SHA-256 before it runs (rustup then checks each toolchain
  # component against the channel manifest). The repository's
  # rust-toolchain.toml (a pinned release since external audit SUP-015)
  # applies once the tree is synced: rustup installs it on the first build.
  - >-
    su - nn -c 'set -e; d=$(mktemp -d);
    curl -fsSL --proto =https --tlsv1.2 -o "$d/rustup-init"
    https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init;
    echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  $d/rustup-init"
    | sha256sum -c --strict --quiet -;
    chmod 0755 "$d/rustup-init";
    "$d/rustup-init" -y --profile minimal --default-toolchain stable;
    rm -rf "$d"'
  - su - nn -c 'echo "source \$HOME/.cargo/env" >> ~/.bashrc'
  - touch /var/lib/nn-lab-provisioned
power_state:
  mode: reboot
  message: "nn-lab: rebooting with lsm=...,bpf"
  condition: true
