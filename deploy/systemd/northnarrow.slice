# Lot 273d (the review of #492): the slice of the NorthNarrow units, the
# agent and its watchdog, of their own. `system.slice.d/*.conf` — the
# host's settings for its system services (a Kubernetes node's reservation,
# a limit an attacker drops there) — no longer reaches them; the slice's
# own drop-in directories are the agent's, refused a new entry outside a
# trusted-installer window, and its resource files are refused like the
# units' (their floors: a quarter of the host's memory, between 544 MiB
# and 1 GiB; half a CPU to one).
[Unit]
Description=NorthNarrow XDR (the agent and its watchdog)
Documentation=https://github.com/northnarrow/northnarrow-new/blob/main/docs/operator/BOOT_INTEGRITY.md
# A stop of the slice is a stop of both units: refused by hand, ignored by
# an isolate (as the units themselves).
RefuseManualStop=yes
IgnoreOnIsolate=yes

[Slice]
