[Unit]
Description=NorthNarrow XDR agent
Documentation=https://github.com/northnarrow/northnarrow-new
# Network online so the agent's outbound posture-engaged behaviour
# has a fully-up interface.
#
# NOTE: we deliberately do NOT depend on `sys-fs-bpf.mount`. /sys/fs/bpf
# is an API virtual filesystem — systemd mounts bpffs itself early in
# boot and REFUSES to materialise a sys-fs-bpf.mount unit ("Cannot
# create mount unit for API file system /sys/fs/bpf. Refusing."), even
# with an /etc/fstab entry. So `Requires=sys-fs-bpf.mount` and
# `After=…sys-fs-bpf.mount` are permanently unsatisfiable and abort the
# start job with "Unit sys-fs-bpf.mount not found". bpffs is always
# present by the time this unit runs; the ExecStartPre= mountpoint
# check in [Service] is the real safety check.
After=network-online.target
# Review 82: the agent refuses kexec images; kdump loads its crash kernel
# first (ignored where kdump is not installed).
After=kdump.service
Wants=network-online.target
# External audit DEP-004: no Condition*/Assert* bpffs pre-flight here —
# see ExecStartPre= in [Service].
# Respawn v2: the watchdog restarts this unit with `systemctl start`
# under its own 5-in-60 s backoff ceiling. systemd's default start-rate
# limiter (5 starts / 10 s) must never veto that, so it is disabled
# here; the ceiling lives in the watchdog, not in systemd.
StartLimitIntervalSec=0
# External audit EBPF-001: no manual stop or restart (`systemctl stop`,
# `restart`, `isolate` of this unit alone): systemd only relays root's
# request, and the task_kill hook refuses its signals outside a signed
# trusted-installer window anyway — without this line systemd ignored the
# EPERM and reported the unit dead while it ran. Stops as a dependency
# (shutdown) still go through. Maintenance, inside the window: `systemctl
# kill -s SIGTERM` (install.sh, uninstall.sh; docs/operator §3.7).
RefuseManualStop=yes
# Lot 273b (tamper case C78b): `systemctl isolate` of another target
# queues no stop job for this unit. (A stop job is not a manual stop:
# RefuseManualStop= does not refuse it; its signals and its cgroup kill are
# refused by the deny hooks, and systemd would record the unit stopped while
# its process runs.)
IgnoreOnIsolate=yes

[Service]
# Lot 273d (the review of #492): a slice of their own — `system.slice.d`
# (the host's settings for its system services) does not reach them.
Slice=northnarrow.slice
Type=notify
# Logging footprint (product guardrail). Route this unit's stdout/stderr
# into NorthNarrow's dedicated, hard-capped journal namespace instead of
# the host default journal. Stock Ubuntu's journald has ForwardToSyslog=yes
# → rsyslog → /var/log/syslog, which has NO size cap (weekly logrotate
# only): that is how a noisy bug filled 76G twice in a day. A non-default
# namespace runs its own systemd-journald@northnarrow (config:
# /etc/systemd/journald@northnarrow.conf, SystemMaxUse=1G) and by systemd
# design does NOT forward to syslog — closing the size-cap AND the
# amplification vectors with one knob, zero customer config. Read NN logs:
#   journalctl --namespace=northnarrow -u northnarrow-agent
LogNamespace=northnarrow
# External audit DEP-017 (NN-AUD-389): journald's rate limit for this unit.
# The default (10000 lines per 30 s, scaled by free disk) drops the rest of
# a burst — a debug log level, a detection storm — and the chain heads
# (`chain head anchored`, lab PR 160) are lines of this journal, the copy
# an operator forwards off the host. Raised, not 0 (no limit): the
# namespace keeps SystemMaxUse=1G, and an unbounded flood would vacuum the
# older lines faster. The watchdog's few lines keep the default.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50000
# External audit DEP-004: the bpffs pre-flight fails the unit. It was
# ConditionPathIsMountPoint=/sys/fs/bpf: unmet, systemd skipped the agent
# and reported its start job done — "inactive (dead)", nothing in
# `systemctl --failed`, the system "running" — and the watchdog's
# `systemctl start --no-block` succeeded the same way. AssertPathIsMountPoint
# fails the start job but still leaves the unit inactive (dead) (checked on
# systemd 255), so the check is a command: without bpffs the unit is failed
# (Result: exit-code), listed by `systemctl --failed`, the system degraded.
# Without bpffs the agent would run with its anti-tamper maps unpinned.
# No OnFailure= here: the watchdog restarts the agent, and holds when a
# queued start brings no agent back (the agent signs that record at its
# next start). Lab PR 216: the watchdog's own unit has one
# (northnarrow-watchdog-failed.service).
ExecStartPre=/usr/bin/mountpoint -q /sys/fs/bpf
# Lot 359 (the re-check 3 of #567, N4): the lock of the pin directory — it
# bound onto itself, private and unbindable, as the child of the host's
# bpffs, before the agent writes a pin. The kernel never takes, in an
# unmount's propagation, a mount that keeps a child that is not itself
# unmounted, and an rbind never copies an unbindable mount: the host's
# bpffs and the pins stay, whatever an rbind copy's unmount takes
# (UPGRADE_NOTES_WAVE4.md §52 lists what it does not cover). `+`: with
# full privileges, outside this unit's sandbox (the agent itself has no
# CAP_SYS_ADMIN and no mount(2), on purpose); LogNamespace= still gives the
# step this unit's mount namespace, so the step enters PID 1's itself
# (setns). `-`: a lock that cannot be made does not fail the start (the
# agent signs the degradation). One already in place is reused; a reboot's
# new bpffs gets a new one.
ExecStartPre=-+/usr/local/bin/northnarrow-agent --pin-lock
# Lab PR 265 (review #466 F4-bis): this unit's runtime drop-in directory,
# made (empty) before every start so that the agent registers it with its
# deny hooks as it does the persistent one: a new drop-in there —
# `systemctl edit --runtime`, or a BindPaths=/TemporaryFileSystem= that
# hides /etc/northnarrow from the next start — is refused outside a signed
# trusted-installer window, and the directory cannot be removed or renamed.
# `+`: outside this unit's sandbox (ProtectSystem=strict keeps /run
# read-only to the agent); `mkdir -p` leaves a directory that is there as it
# is. A mount over the agent's directories made any other way refuses the
# start (docs/operator/BOOT_INTEGRITY.md, section 1).
ExecStartPre=+/bin/mkdir -p /run/systemd/system/northnarrow-agent.service.d
# The review of #497 (N7): the persistent one too — install.sh made it only
# for its own drop-ins (Debian, --cow-guard), so elsewhere it did not exist,
# was not NOCREATE, and root could make it outside a window.
ExecStartPre=+/bin/mkdir -p /etc/systemd/system/northnarrow-agent.service.d
# Lot 273b (the review of #489, R2): the `system.control` directories of
# both units, where `systemctl set-property` writes the drop-in that keeps a
# property: made (empty) before every start, so that the agent registers
# them with its deny hooks too. A lowered MemoryMax=/TasksMax=/CPUQuota= is
# refused at the cgroup file; its drop-in would still apply it to the next
# start's fresh cgroup, before the agent is there.
ExecStartPre=+/bin/mkdir -p /etc/systemd/system.control/northnarrow-agent.service.d /run/systemd/system.control/northnarrow-agent.service.d /etc/systemd/system.control/northnarrow-watchdog.service.d /run/systemd/system.control/northnarrow-watchdog.service.d
# The review of #490 (A): the watchdog's drop-in directories and the
# `northnarrow-.service.d` prefix ones, whose drop-ins apply to both units
# (systemd 246 and later): made (empty) so that the agent registers them
# NOCREATE like its own. A drop-in there would reach the next start's
# fresh cgroup before the agent is there to refuse it.
ExecStartPre=+/bin/mkdir -p /etc/systemd/system/northnarrow-watchdog.service.d /run/systemd/system/northnarrow-watchdog.service.d /etc/systemd/system/northnarrow-.service.d /run/systemd/system/northnarrow-.service.d
# Lot 273d: the slice's drop-in directories, made empty the same way and
# registered NOCREATE (a drop-in there would reach both units' slice).
ExecStartPre=+/bin/mkdir -p /etc/systemd/system/northnarrow.slice.d /run/systemd/system/northnarrow.slice.d /etc/systemd/system.control/northnarrow.slice.d /run/systemd/system.control/northnarrow.slice.d
# External audit ATP-014 (NN-AUD-262): an explicit search path, without
# /usr/local. systemd's default for a service starts with
# /usr/local/sbin:/usr/local/bin, which the FIM list does not watch, and
# COMBAT's iptables-restore, `nft` and `rpm` were looked up on it: a copy
# planted there ran instead. The agent no longer searches PATH for them
# (agent/src/trusted_bin.rs: /usr/sbin, /usr/bin, /sbin, /bin only, a
# root-owned file nobody else can write); this line is defence in depth
# for anything it starts. A drop-in that overrides it is a `unit_dropin`
# self-integrity finding.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Lot 374: the dynamic loader's and the C library's variables are unset,
# whatever the service manager's own environment (`systemctl
# set-environment`) or a drop-in gives: systemd applies UnsetEnvironment=
# last. No start of this unit runs with code or a library path given to it
# before its `main` (the list is antitamper-bpf's `start_check::LOADER_ENV`;
# a start that finds one all the same refuses itself, signed).
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_ASSUME_KERNEL
UnsetEnvironment=LD_BIND_NOT LD_BIND_NOW LD_DEBUG LD_DEBUG_OUTPUT
UnsetEnvironment=LD_DYNAMIC_WEAK LD_HWCAP_MASK LD_ORIGIN_PATH
UnsetEnvironment=LD_POINTER_GUARD LD_PREFER_MAP_32BIT_EXEC LD_PROFILE
UnsetEnvironment=LD_PROFILE_OUTPUT LD_SHOW_AUXV LD_TRACE_LOADED_OBJECTS
UnsetEnvironment=LD_TRACE_PRELINKING LD_USE_LOAD_BIAS LD_VERBOSE LD_WARN
UnsetEnvironment=GCONV_PATH GETCONF_DIR GLIBC_TUNABLES HOSTALIASES
UnsetEnvironment=LOCALDOMAIN LOCPATH MALLOC_ARENA_MAX MALLOC_ARENA_TEST
UnsetEnvironment=MALLOC_CHECK_ MALLOC_MMAP_MAX_ MALLOC_MMAP_THRESHOLD_
UnsetEnvironment=MALLOC_PERTURB_ MALLOC_TOP_PAD_ MALLOC_TRACE
UnsetEnvironment=MALLOC_TRIM_THRESHOLD_ NIS_PATH NLSPATH RESOLV_HOST_CONF
UnsetEnvironment=RES_OPTIONS TZDIR
ExecStart=/usr/local/bin/northnarrow-agent \
    --combat-rules /etc/northnarrow/combat-rules.v4 \
    --combat-rules-v6 /etc/northnarrow/combat-rules.v6 \
    --admin-pub /etc/northnarrow/admin.pub \
    --admin-socket /run/northnarrow/admin.sock \
    --pid-file /run/northnarrow/agent.pid
# Watchdog (Tappa 7 task 6 W4) owns restart policy. systemd MUST
# NOT auto-restart the agent — doing so would race the
# watchdog's restart-backoff loop and double-spawn agents on
# every death. Per design §2.3 "restart policy lives only in
# the watchdog — the agent's systemd unit uses Restart=no and
# delegates respawn to the watchdog." Respawn v2: the watchdog's
# respawn IS `systemctl start northnarrow-agent.service`, so a
# crash → backoff → fresh instance of THIS unit (same ExecStart,
# caps, cgroup, ProtectHome) — never a child of the watchdog.
Restart=no
# External audit EBPF-001: outside a signed trusted-installer window the
# task_kill hook refuses systemd's signals; a stop job (shutdown) then ends
# within TimeoutStopSec with the process still running, which ends with
# systemd-shutdown's final SIGTERM (allowed). SendSIGKILL=no: with a
# process left in the cgroup systemd refuses to start a second instance.
# Lot 288 (#125): the agent's own stop ends within 2 s of its loop's end,
# the kernel's release of its BPF programs after the exit kept 3 s (2.4 s
# measured; agent/src/stop_deadline.rs, whose test reads this value): what
# blocks past it is cut, signed, and the agent exits with status 75.
TimeoutStopSec=5s
SendSIGKILL=no
# Lab PR 216 (static review C-43): READY=1 comes once every subsystem is
# wired — the eBPF programs attached, the FIM baseline and the ADE loaded
# (a cold GGUF load measured 17.8 s, docs/ADE_BACKEND_NOTES.md). Explicit,
# not systemd's 90 s default: a start that has not signalled after 180 s is
# failed. The task_kill hook refuses the SIGTERM that follows, so the value
# errs long — a stranded `failed` unit with a running agent is worse than a
# late verdict.
TimeoutStartSec=180s
# Lab PR 216 (static review C-43 / G-06): no core dump — the agent holds its
# signing key. It is not dumpable either (process_hardening: PR_SET_DUMPABLE
# 0 and RLIMIT_CORE 0 at its start).
LimitCORE=0
# R14c (lot 272, plan §3.1): the system calls this process and every
# program it starts never make, refused (EPERM, the call's error — not a
# kill: an agent stopped by one stray call would be a way to stop it);
# validated in the lab on every supported kernel (deploy/lab/caps/
# thread-caps.sh: none of them made through the lab's runs). No
# ptrace or process_vm_writev (the agent reads /proc, it never attaches),
# no kexec or module load (the agent refuses them to others), no swap,
# reboot, mount or pivot_root, no userfaultfd, no open_by_handle_at (the
# copy-on-first-write guard opens by path). Native system calls only (no
# x32 or i386 entry), and the execution domain locked.
SystemCallFilter=~ptrace process_vm_writev kexec_load kexec_file_load init_module finit_module delete_module swapon swapoff reboot mount umount2 pivot_root userfaultfd open_by_handle_at
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
LockPersonality=yes
# The review of #582 (F2 b): no memory both writable and executable, and
# none made executable later — what a start of this unit maps executable
# is its binary's and its libraries' files, as its executable mappings
# show (the start's own check, the other role's reading of it). The
# re-check of #582 (N7): it does not keep a file mapping's pages as the
# file holds them once mapped. Neither daemon makes any (no JIT; the eBPF
# programs are the kernel's to compile).
MemoryDenyWriteExecute=yes
RuntimeDirectory=northnarrow
RuntimeDirectoryMode=0700
# /run/northnarrow is SHARED with the watchdog (watchdog.pid, the A8
# shutdown marker, honeypot control-surface baits). Without Preserve,
# systemd wipes and recreates the directory every time THIS unit stops —
# i.e. on every respawn-v2 restart — and the watchdog's pidfile vanishes
# (seen on the lab guest: "cat: /run/northnarrow/watchdog.pid: No such
# file" right after a respawn-check). Preserve keeps it across restarts;
# it is still removed at shutdown (tmpfs).
RuntimeDirectoryPreserve=yes

# Resource ceilings (Beta Step 2a — confine a runaway to the agent's own
# cgroup instead of letting the kernel OOM-killer roam the host and reap
# sshd / other critical services — "Family A" resource-exhaustion
# cascade).
#
#   MemoryHigh — soft throttle. Above this the cgroup is put under
#     reclaim pressure (and briefly stalled) but NOT killed.
#   MemoryMax — hard ceiling. The cgroup's own OOM-killer fires here,
#     killing ONLY the agent (the watchdog then respawns it per its
#     own restart policy).
#   The sizes — lot 381, from the pre-alpha's Phase 6b (rc11, 2 and 4
#     vCPU, Ubuntu 24.04 and Debian 13): the agent's cgroup peaked at
#     316 MiB at a cold start (about 165 MiB of it kernel memory, the BPF
#     maps), at most 264 MiB under a 2,600 exec/s storm, a full FIM set and
#     200 container starts; about 200 MiB at rest. MemoryMax=1G is 3.2
#     times the peak: a cap near it would fail the maps' load at a start,
#     not just a malloc. MemoryHigh=768M throttles only well above every
#     measured load (above it the kernel reclaims and stalls the agent,
#     which would then lose events). Not measured: hosts of 16 or more
#     CPUs (the per-CPU rings) and larger FIM sets — re-checked in the
#     final release candidate's soak. They replace 9G / 11G, sized for the
#     on-host LLM advisor removed in Wave 4 (lab PR 214). A ratchet test
#     (watchdog/tests/systemd_units.rs) keeps them tied to that measure.
#     On a host whose memory is not above MemoryMax the cap cannot bind:
#     see OOMScoreAdjust below. The sizes stay absolute (external audit
#     DEP-005): the self-integrity check compares them with the cgroup
#     files, which it cannot do for a percentage.
#   TasksMax — fork/thread-leak backstop. The agent runs a tokio
#     runtime (a few workers) plus FIM / net / admin tasks — a few dozen
#     at most. 512 is well above any legitimate count yet caps a runaway.
#
# NOTE: deliberately NO CPUQuota. Unlike the watchdog (idle until the
# agent dies, so capped at 10%), the agent does latency-sensitive
# detection; throttling CPU would slow verdicts without bounding the OOM
# vector this block exists to contain. Memory is the cascade risk, so
# memory is what we cap.
MemoryHigh=768M
MemoryMax=1G
TasksMax=512
# OOMScoreAdjust — lot 370 (F10-4): -999, the host OOM killer's last pick.
# Its SIGKILL is one no hook can refuse, so the agent's role can fall
# vacant. Lot 374: the watchdog then signs the vacancy (its cause as
# systemd records it) and the process that takes the role, in its own
# witness chain, which the agent imports. Only this unit's own restart
# takes the role, and a start that finds a loader variable or a library
# the release does not link refuses itself. Not -1000: that would make the
# agent unkillable by its
# own cgroup's OOM too, so a leak would hang its allocations or weigh on
# the host; with -999 a leak past MemoryMax ends in the cgroup's OOM kill
# and a restart (the watchdog). The agent writes it again at its start,
# whoever started it, and the self-integrity check reports another value as
# `integrity_drift`. It replaces -500 and external audit DEP-005's raise to
# 0 where MemoryMax cannot bind (a host with less memory than the cap: there
# a leak still weighs on the host before it reaches the cap).
OOMScoreAdjust=-999
# OOMPolicy — the lab round 5 of #582: continue. An OOM kill of one
# process of the unit leaves the rest running. The agent's workers are the
# OOM killer's first pick (oom_score_adj 1000), and the agent respawns
# them. With systemd's default (stop), one worker's OOM kill made systemd
# stop the whole unit. The task_kill hook refuses that stop outside a
# window, so the unit was left `failed` with the agent still running and
# no main PID. Every start after it failed ('resources': SendSIGKILL=no
# with a process left in the cgroup). systemd also failed the unit before
# it reaped the agent, so the exit was never recorded and the watchdog
# signed the vacancy's cause "not known". With continue, the agent's own
# OOM kill is recorded as its exit (signal 9). The watchdog names the
# OOM killer from the slice's oom_kill count. A drop-in that sets
# OOMPolicy=stop or kill is judged harmful (antitamper_bpf::host_dropins).
OOMPolicy=continue

# Hardening — `ProtectSystem=strict` makes the entire filesystem
# read-only EXCEPT the ReadWritePaths whitelist below. NoNewPrivileges
# kills any latent setuid-binary escalation in case the agent ever
# spawns one.
#
# NOTE: /sys/fs/bpf/northnarrow is intentionally NOT listed. Listing a
# path under the /sys/fs/bpf API VFS makes systemd inject an implicit
# Requires=/After= on the (unsatisfiable) sys-fs-bpf.mount unit — the
# same failure mode as the explicit dep removed above. It is also
# unnecessary: ProtectSystem=strict EXEMPTS /dev, /proc and /sys from
# the read-only remount (only ProtectKernelTunables= would make /sys
# read-only, and we do not set it), so the agent retains write access
# to its bpffs pin directory without a ReadWritePaths entry.
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome=read-only — deliberately NOT =yes/=true. The FIM
# credential-read rules (NN-L-FIM-011..017: AWS/Azure/GCP/Docker/browser/
# KeePass/GnuPG, plus the /root + /home SSH-key & shell-history watches)
# depend on the agent being able to stat(2) those files at boot to record
# their (dev,ino) in the kernel WATCHED_PATHS map — the BPF observe hooks
# only emit a FIM event for an inode that is IN that map. `ProtectHome=yes`
# mounts an EMPTY tmpfs over /home, /root and /run/user inside this unit's
# mount namespace, so every credential stat() returns ENOENT, those inodes
# never enter WATCHED_PATHS, and the credential-theft rules fire NOTHING —
# a silent, total coverage hole (the kernel BPF side still sees the opens;
# it simply has no watched inode to match them against). `read-only`
# restores visibility while keeping the write-hardening intact: the agent
# only ever stat()s/reads these paths — it NEVER writes under a home dir
# (all writes go to the ReadWritePaths below) — so read-only costs us
# nothing and is verifiable with `systemd-analyze security`. Do NOT revert
# to =yes without first removing every /root + /home entry from
# configs/fim-paths.v1; the boot-time regression guard in
# agent/src/fim/attach.rs (populate_watched_paths) WARNs if this is ever
# masked again.
ProtectHome=read-only
# /etc/northnarrow MUST be writable for the agent (review
# `etc-readonly-audit-1`, 2026-10-08): the signed audit log
# (/etc/northnarrow/audit.log), agent_id and agent.sig.key bootstrap,
# and the rename-based admin.pub rotation all live there. With the
# directory read-only every COMBAT stage transition logged
# "failed to append ... audit log" (EROFS, hidden behind the context
# string) and the audit chain stopped at the last write made outside
# the unit — silently, for months. Writes there are still restricted to
# THIS process: the inode_protect write-deny hooks refuse every other
# pid (at-authz-1/2), so widening the mount does not widen the attack
# surface.
# Lot 276: the export worker's JSONL files (docs/operator/EXPORT.md). The
# `-` keeps the unit starting where install.sh did not make it; the worker's
# Landlock rule is this directory alone, and only it writes there.
ReadWritePaths=/run/northnarrow /var/lib/northnarrow /etc/northnarrow -/var/log/northnarrow/export
# Lot 273d: our units' and slice's own drop-in directories (the ones the
# ExecStartPre=+ lines above make), so that a harmful drop-in made inside a
# trusted-installer window is moved to /var/lib/northnarrow/quarantine at the
# window's close (crates/nn-linux/src/own_dropins.rs). Read-only here, the
# move failed with EROFS (the lab's round 11 on Debian 13: "NOT moved
# (Read-only file system)") and the drop-in applied at the next reload.
# Writes there stay this process's: the directories are NOCREATE to every
# other pid. `-`: one not made yet (the first ExecStartPre=) is skipped.
ReadWritePaths=-/etc/systemd/system/northnarrow-agent.service.d -/run/systemd/system/northnarrow-agent.service.d -/etc/systemd/system.control/northnarrow-agent.service.d -/run/systemd/system.control/northnarrow-agent.service.d -/etc/systemd/system/northnarrow-watchdog.service.d -/run/systemd/system/northnarrow-watchdog.service.d -/etc/systemd/system.control/northnarrow-watchdog.service.d -/run/systemd/system.control/northnarrow-watchdog.service.d -/etc/systemd/system/northnarrow-.service.d -/run/systemd/system/northnarrow-.service.d -/etc/systemd/system/northnarrow.slice.d -/run/systemd/system/northnarrow.slice.d -/etc/systemd/system.control/northnarrow.slice.d -/run/systemd/system.control/northnarrow.slice.d
# CapabilityBoundingSet — the agent runs as root (no User=), so this set is
# the HARD CEILING on its effective caps: a cap not listed is dropped even
# from root. It is the blast radius if the agent is ever compromised, so it
# is kept minimal. Every entry is load-bearing, proven under the real bounded
# unit on kernel 6.8.0 (BUG-042). The prior set was wrong three ways: it
# silently dropped CAP_LINUX_IMMUTABLE and CAP_SYS_PTRACE (two agent defenses
# that only "worked" in unbounded smoke tests), and it carried the near-root
# CAP_SYS_ADMIN for BPF work that CAP_BPF + CAP_PERFMON actually cover.
#
# CAP_BPF          — create + load + pin the eBPF maps/programs/ringbufs.
# CAP_PERFMON      — BTF-attach the tracing programs (sched_process_exec,
#                    tcp_connect_v4/v6, dns_query, tcp_close, …) AND the
#                    BPF-LSM programs (inode_protect deny hooks, task_kill,
#                    ptrace_access_check, fim observe). On 6.8 both attach
#                    types gate on perfmon_capable(); with CAP_BPF this fully
#                    replaces the old CAP_SYS_ADMIN — verified by attaching
#                    all 17 progs under CAP_BPF+CAP_PERFMON alone, with no
#                    CAP_SYS_ADMIN and no CAP_MAC_ADMIN (BUG-042). CAP_BPF
#                    alone EPERMs the BPF_PROG_LOAD of these.
# CAP_NET_ADMIN    — iptables/ip6tables-restore for the COMBAT isolation
#                    chain: engage + teardown, v4 AND v6 (BUG-031).
# CAP_LINUX_IMMUTABLE — chattr +i (FS_IOC_SETFLAGS|FS_IMMUTABLE_FL) on
#                    /var/lib/northnarrow, the anti-tamper defence-in-depth
#                    (anti_tamper/filesystem.rs). THIS is the cap +i needs —
#                    NOT CAP_DAC_OVERRIDE, which the prior comment wrongly
#                    credited (BUG-042). Without it the agent logs
#                    "chattr +i failed" and runs with LSM-only protection.
# CAP_SYS_PTRACE   — readlink /proc/<pid>/exe on OTHER processes
#                    (posture/lineage.rs, posture/exempt.rs,
#                    response/quarantine.rs). ptrace_may_access denies this to
#                    root for a cross-uid OR non-dumpable target without the
#                    cap (BUG-042) — needed for auth-session lineage
#                    correlation and quarantine target resolution.
# CAP_KILL         — kill(2) towards processes of ANOTHER uid. Without it a
#                    uid-0 sender may only signal uid-0 targets, so every
#                    KillProcess/KillProcessTree verdict against a user-owned
#                    process returns EPERM — the agent could never stop
#                    malware run by a normal user. The agent's boot
#                    preflight (response/caps_preflight.rs) refuses to start
#                    in enforcement mode when this cap is absent.
# CAP_DAC_OVERRIDE — quarantine reach ONLY: read + unlink a malicious binary
#                    that lives in a non-root, restrictive-perm directory
#                    (response/quarantine.rs). NOT for +i, NOT for FIM (all
#                    125 watched paths are root-owned → read by ownership).
#                    The sticky dirs (/tmp, /var/tmp, /dev/shm) are owned by
#                    root, so the sticky check lets root unlink there without
#                    CAP_FOWNER (lab, review 87).
# CAP_SETFCAP      — StripFileCapability (review 86): removing a
#                    `security.capability` xattr a process granted needs it.
# Responses that change a file (quarantine's unlink, the strip) reach it
# through /proc/1/root (response/mod.rs: host_path), the host's mount
# namespace, because ProtectSystem=strict leaves this unit's own view
# read-only outside ReadWritePaths; CAP_SYS_PTRACE covers that traversal.
# Debian-family kernels: perf_event_paranoid=3 semantics need CAP_SYS_ADMIN
# for the tracepoint/kprobe attach; install.sh adds it there through the
# drop-in northnarrow-agent.service.d/10-debian-perf-paranoid.conf.
# Lab PR 223 (EXPERIMENTAL exec quarantine): CAP_SETUID and CAP_SETGID
# let the agent start its scanner as the unprivileged `northnarrow-scan`
# account (setgroups/setgid/setuid in the child before exec). Without them
# the guard refuses to start (a signed degradation), the agent runs.
# R14a (lot 272): the same two start the workers as `northnarrow-worker`
# (docs/operator/WORKERS.md); nothing else uses them.
#
# R14c (lot 272, plan §3.1): this set is the process's ceiling; each of
# the agent's threads keeps EFFECTIVE only what its role needs
# (crates/nn-linux/src/caps; docs/architecture/PROCESS_MODEL.md): the
# decision thread CAP_SYS_PTRACE alone, given up for good, with a seccomp
# filter of its own (no capset, execve, execveat, bpf); the response
# workers CAP_KILL CAP_NET_ADMIN CAP_SETFCAP CAP_DAC_OVERRIDE
# CAP_SYS_PTRACE; the canary writer CAP_LINUX_IMMUTABLE; the workers'
# supervisor CAP_SETUID CAP_SETGID CAP_KILL CAP_BPF; the eBPF load CAP_BPF
# CAP_PERFMON; the decision's errands CAP_BPF; the rest the whole set.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_LINUX_IMMUTABLE CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_KILL CAP_SETFCAP CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
