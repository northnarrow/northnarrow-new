[Unit]
Description=NorthNarrow XDR watchdog (anti-tamper supervisor)
Documentation=https://github.com/northnarrow/northnarrow-new/blob/main/docs/design/TAPPA7_TASK6_WATCHDOG_DESIGN.md
# After (not Requires) — the watchdog tolerates a slow agent
# start via its W2 PIDFD_OPEN_RETRY_DEADLINE (30 s polling for
# /run/northnarrow/agent.pid). systemd ordering guarantees the
# agent unit's ExecStart fires first; the watchdog catches up.
After=northnarrow-agent.service
# Respawn v2 (docs/design/WATCHDOG_RESPAWN_V2_DESIGN.md): NO BindsTo=.
# BindsTo stopped this unit whenever the agent unit went inactive —
# which it does on a CRASH too (Restart=no), i.e. exactly when the
# watchdog is needed. An operator-intended stop is recognised by the
# A8 shutdown marker (/run/northnarrow/agent.shutdown_authorised,
# written on a signed stop): marker present → the watchdog stands
# down instead of respawning. Wants= pulls the agent in when the
# watchdog is started on a cold host.
Wants=northnarrow-agent.service
# External audit EBPF-001: no manual stop or restart (`systemctl stop`,
# `restart`, `isolate` of this unit alone): systemd only relays root's
# request, and the task_kill hook refuses its signals outside a signed
# trusted-installer window anyway — without this line systemd ignored the
# EPERM and reported the unit dead while it ran. Stops as a dependency
# (shutdown) still go through. Maintenance, inside the window: `systemctl
# kill -s SIGTERM` (install.sh, uninstall.sh; docs/operator §3.7).
RefuseManualStop=yes
# Lab PR 216 (capability C23): the watchdog never stays down. No start
# limit — systemd retries it forever (Restart=always below, with a backoff
# growing to 60 s) — and each failed run is visible on its own: the
# watchdog's `watchdog_exit` record (its exit status and why) and the
# agent's `watchdog_gone`, both signed by the agent at its next round, and
# the unit's NRestarts counter. OnFailure= still covers what leaves the unit
# itself `failed` (a start or stop job systemd fails, not a death of the
# process, which is restarted): its handler records `watchdog_failed`.
StartLimitIntervalSec=0
OnFailure=northnarrow-watchdog-failed.service
# No Requires=sys-fs-bpf.mount: /sys/fs/bpf is an API VFS with no
# materialisable mount unit (see northnarrow-agent.service). The
# watchdog is ordered After= the agent, whose ExecStartPre= has already
# checked bpffs (and failed the agent unit without it).

[Service]
Type=notify
# Logging footprint — same journal namespace as the agent (see agent unit).
# With the systemd respawn backend the agent logs through its own unit;
# the namespace is kept here for the watchdog's own lines and for the
# `exec` backend (non-systemd hosts), where a fork-exec'd agent inherits
# this unit's stdio and must not reach the uncapped default journal.
LogNamespace=northnarrow
# External audit ATP-014 (NN-AUD-262): an explicit search path, without
# the /usr/local of systemd's default (see northnarrow-agent.service). The
# watchdog runs `systemctl` by absolute path and the agent by --agent-bin;
# on the `exec` backend the agent it starts inherits this environment.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/northnarrow-watchdog \
    --agent-bin /usr/local/bin/northnarrow-agent \
    --agent-pidfile /run/northnarrow/agent.pid \
    --admin-socket /run/northnarrow/admin.sock \
    --pidfile /run/northnarrow/watchdog.pid \
    --bpffs-root /sys/fs/bpf/northnarrow \
    --agent-unit northnarrow-agent.service
# Respawn v2: on a systemd host (the default, --respawn-backend auto) a
# crashed agent is brought back with `systemctl start --no-block
# northnarrow-agent.service`, so it returns under ITS OWN unit — the
# ExecStart argv above (incl. --detect-only when configured), its own
# cgroup/MemoryMax, CapabilityBoundingSet, ProtectHome=read-only and
# journal namespace. It is no longer a fork-exec child of this unit's
# 64 MiB / 2-cap sandbox. --agent-bin is only consulted by the `exec`
# backend (non-systemd hosts), where it overrides argv[0] of the full
# argv the watchdog captures from /proc/<agent>/cmdline at boot.
# Watchdog owns ITS OWN restart policy via systemd. The agent it was
# protecting is unaffected by its death — the agent's PROTECTED_PIDS entry
# persists because the bpffs map pin is independent of the watchdog
# process lifetime — and the agent signs that the watchdog is gone
# (`watchdog_gone`).
# Lab PR 216 (static review C-44 / G-05): Restart=always, except a stop the
# watchdog was told to make. It exits 0 only then — SIGTERM/SIGINT (a
# maintenance stop inside the trusted-installer window, a shutdown) or a
# shutdown the admin quorum signed — and RestartPreventExitStatus=0 keeps
# systemd from undoing it. Every failure has a non-zero status of its own
# (watchdog/src/lib.rs `ExitReason`: 10 hardening, 11 no verified agent
# within 30 s, 12 pidfile, 13 respawn backend, 14 READY=1, 15 signal
# handlers, 20 the wait on the agent's pidfd) and leaves a `watchdog_exit`
# record; a death by any signal (SIGKILL, SIGHUP, an abort) is restarted
# too. With Restart=on-failure, "pidfd wait failed" exited 0 and was never
# restarted, and a SIGHUP counted as a clean stop.
Restart=always
RestartPreventExitStatus=0
# External audit EBPF-001: outside a signed trusted-installer window the
# task_kill hook refuses systemd's signals; a stop job (shutdown) then ends
# within TimeoutStopSec with the process still running, which ends with
# systemd-shutdown's final SIGTERM (allowed). SendSIGKILL=no: with a
# process left in the cgroup systemd refuses to start a second instance.
TimeoutStopSec=5s
SendSIGKILL=no
# Backoff between restarts: 2 s, growing in 5 steps to 60 s, then every
# 60 s for as long as it fails (systemd 254+; an older systemd ignores
# RestartSteps=/RestartMaxDelaySec= with a warning and restarts every 2 s).
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
# Lab PR 216 (static review C-43): READY=1 follows the verified agent pidfd,
# at most 30 s after the start (PIDFD_OPEN_RETRY_DEADLINE): the watchdog's
# own deadline — exit 11, recorded — fires before systemd's.
TimeoutStartSec=60s
# Lab PR 216 (static review C-43 / G-06): no core dump. The watchdog is not
# dumpable either (harden_self: PR_SET_DUMPABLE 0).
LimitCORE=0
# Lab PR 216: /run/northnarrow is created 0700 whichever unit starts first
# (the agent's unit declares the same; Preserve keeps it shared across
# restarts of either).
RuntimeDirectory=northnarrow
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# Resource ceilings per design §9 "Resource ceiling (V1 targets)":
#   RSS ≤ 10 MB steady state. The whole binary is a tokio runtime
#     + one pidfd + an aya map handle. No model, no rules, no
#     telemetry buffers. 64 MB cap is 6× over target, leaves
#     headroom for legitimate spikes (Command::spawn allocations,
#     log-buffer transients).
#   CPU ≤ 0.1% steady state. Nothing happens until the agent
#     dies or 30 s elapses (the STATUS-ping tick). 10% cap is
#     100× over target — generous slack for restart-cycle bursts
#     without giving an attacker headroom to mine cryptocurrency.
#   TasksMax=8 — the watchdog spawns at most: main + ping-loop +
#     a handful of tokio worker threads, plus one transient
#     `systemctl` child during a respawn. 8 catches any thread leak
#     well before it matters.
MemoryMax=64M
CPUQuota=10%
TasksMax=8
# OOMScoreAdjust — 64 MiB at most, and the process that brings the agent
# back: the last thing the OOM killer should pick.
OOMScoreAdjust=-900

# Hardening — same shape as the agent's unit. The watchdog is a
# smaller target but the same posture (no new privileges, no
# writable system, capability bounding) reduces blast radius if
# the binary is ever compromised.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Watchdog only writes /run/northnarrow/watchdog.pid and reads
# the agent pidfile + shutdown_authorised marker (also under
# /run/northnarrow/). It also reads/evicts the pinned PROTECTED_PIDS
# map under /sys/fs/bpf/northnarrow (W1+W3), but /sys/fs/bpf is NOT
# listed here: ProtectSystem=strict exempts /sys from the read-only
# remount, so the watchdog keeps write access without the entry, and
# listing it would inject the unsatisfiable sys-fs-bpf.mount dependency
# (see northnarrow-agent.service).
# `systemctl start` is an exec of a read-only system binary plus a
# connect() to /run/dbus/system_bus_socket; a read-only /run does not
# block unix-socket connects (EROFS applies to regular files/dirs only).
# If a host proves otherwise, add /run/dbus here (design §3.2 / §5.1).
ReadWritePaths=/run/northnarrow
# CAP_BPF        — open the pinned maps by path (BPF_OBJ_GET and the
#                  info of the fd), claim the watchdog's role slot,
#                  insert into and delete from PROTECTED_PIDS: all
#                  bpf_capable(), CAP_BPF from kernel 5.8 (the floor)
# CAP_SYS_PTRACE — read /proc/<agent>/exe to verify that the pid the
#                  agent pidfile names runs the agent binary before it
#                  is protected, signalled or respawned from (external
#                  audit WDG-003); the agent is not dumpable, so its
#                  exe link is closed to a root process without it
# External audit DEP-014 (NN-AUD-386): no CAP_SYS_ADMIN. It was "kept for
# the historical bpf(2) shape"; nothing the watchdog does needs it. The
# respawn's `systemctl start` is authorised by uid 0 on systemd's private
# socket, which carries no capabilities. No CAP_NET_ADMIN or
# CAP_DAC_OVERRIDE either: the watchdog never touches the firewall or a
# file it does not own.
CapabilityBoundingSet=CAP_BPF CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
