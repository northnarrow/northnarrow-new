[Unit]
Description=NorthNarrow XDR watchdog failure record
Documentation=https://github.com/northnarrow/northnarrow-new/blob/main/docs/operator/INSTALL_UPGRADE_UNINSTALL.md
# Lab PR 216 (capability C23): the OnFailure= handler of
# northnarrow-watchdog.service. systemd starts it when the watchdog unit
# enters the failed state. A death of the watchdog process is restarted
# (Restart=always, no start limit), so this is what fails the unit itself —
# a start or stop job systemd fails — and leaves the agent without a
# supervisor until the unit is started again. It appends one
# `watchdog_failed` record to
# /run/northnarrow/watchdog.hold, with systemd's MONITOR_SERVICE_RESULT,
# MONITOR_EXIT_CODE and MONITOR_EXIT_STATUS, and logs an ERROR on
# `watchdog.tamper`; the running agent signs the record at its next
# self-integrity round (every 30 s ±20 %) as an `integrity_drift`
# (`watchdog_failed`). Not enabled and without [Install]: only OnFailure=
# starts it. Each failed run that systemd restarts is recorded by the
# watchdog itself (`watchdog_exit`) and by the agent (`watchdog_gone`).

[Service]
Type=oneshot
LogNamespace=northnarrow
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Lot 374: the dynamic loader's and the C library's variables are unset,
# whatever the service manager's own environment (`systemctl
# set-environment`) or a drop-in gives: systemd applies UnsetEnvironment=
# last. No start of this unit runs with code or a library path given to it
# before its `main` (the list is antitamper-bpf's `start_check::LOADER_ENV`;
# a start that finds one all the same refuses itself, signed).
UnsetEnvironment=LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH LD_ASSUME_KERNEL
UnsetEnvironment=LD_BIND_NOT LD_BIND_NOW LD_DEBUG LD_DEBUG_OUTPUT
UnsetEnvironment=LD_DYNAMIC_WEAK LD_HWCAP_MASK LD_ORIGIN_PATH
UnsetEnvironment=LD_POINTER_GUARD LD_PREFER_MAP_32BIT_EXEC LD_PROFILE
UnsetEnvironment=LD_PROFILE_OUTPUT LD_SHOW_AUXV LD_TRACE_LOADED_OBJECTS
UnsetEnvironment=LD_TRACE_PRELINKING LD_USE_LOAD_BIAS LD_VERBOSE LD_WARN
UnsetEnvironment=GCONV_PATH GETCONF_DIR GLIBC_TUNABLES HOSTALIASES
UnsetEnvironment=LOCALDOMAIN LOCPATH MALLOC_ARENA_MAX MALLOC_ARENA_TEST
UnsetEnvironment=MALLOC_CHECK_ MALLOC_MMAP_MAX_ MALLOC_MMAP_THRESHOLD_
UnsetEnvironment=MALLOC_PERTURB_ MALLOC_TOP_PAD_ MALLOC_TRACE
UnsetEnvironment=MALLOC_TRIM_THRESHOLD_ NIS_PATH NLSPATH RESOLV_HOST_CONF
UnsetEnvironment=RES_OPTIONS TZDIR
ExecStart=/usr/local/bin/northnarrow-watchdog --record-unit-failure \
    --agent-pidfile /run/northnarrow/agent.pid
TimeoutStartSec=30s
LimitCORE=0
# A file append under /run/northnarrow, nothing else: no capability (root
# owns the 0700 directory), no network, a read-only system.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateNetwork=true
RuntimeDirectory=northnarrow
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/northnarrow
CapabilityBoundingSet=
